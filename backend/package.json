{
  "name": "fitquest-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.12.0 <25"
  },
  "scripts": {
    "build": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\" && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "test": "npm run build && npm run build:test && node --test dist-test/tests/unit/*.test.js dist-test/tests/integration/*.test.js",
    "check": "npm test",
    "eval:smoke": "npm run build:test && node --env-file=.env.local dist-test/evaluation/onboardingEvaluation.js --smoke",
    "eval:conversation": "npm run build:test && node --env-file=.env.local dist-test/evaluation/onboardingEvaluation.js --conversation",
    "eval:suite": "npm run build:test && node --env-file=.env.local dist-test/evaluation/onboardingEvaluation.js --suite",
    "build:test": "node -e \"require('node:fs').rmSync('dist-test',{recursive:true,force:true})\" && tsc -p tsconfig.test.json",
    "typecheck": "tsc -p tsconfig.test.json --noEmit"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "ajv": "8.20.0",
    "fastify": "^5.12.5",
    "pg": "^8.23.1"
  },
  "devDependencies": {
    "@types/node": "^24.19.1",
    "@types/pg": "^8.23.1",
    "typescript": "~6.0.3"
  }
}
