SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
# Restricted fitquest_app role via Supabase's TLS pooler; never a postgres/admin connection.
DATABASE_URL=postgresql://fitquest_app.PROJECT_REF:REPLACE_ME@POOLER_HOST:5432/postgres?sslmode=verify-full

# Owner approved GPT-6 Luna, $7 TOTAL including at most $0.25 initial evaluation.
# Production stays off until HQ review/activation and evaluation liabilities are carried forward.
ONBOARDING_AI_ENABLED=false
ONBOARDING_AI_APPROVED=true
ONBOARDING_POLICY_APPROVED=true
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
ONBOARDING_TOTAL_USD=7
# Standard rates verified 2026-10-03; conservative accounting includes cache-write rate.
OPENAI_INPUT_USD_PER_M=0.10
OPENAI_CACHED_USD_PER_M=0.01
OPENAI_CACHE_WRITE_USD_PER_M=0.125
OPENAI_OUTPUT_USD_PER_M=0.50
# Live evaluation uses a separate persistent LOCAL database, never FITQUEST_TEST_DATABASE_URL.
# FITQUEST_EVAL_DATABASE_URL=postgresql://fitquest_app@127.0.0.1:55433/fitquest_ai_evaluation
