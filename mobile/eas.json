{
  "cli": {
    "version": ">=24.9.0",
    "appVersionSource": "local"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal",
      "environment": "development",
      "ios": {
        "resourceClass": "medium"
      }
    },
    "preview": {
      "developmentClient": false,
      "distribution": "internal",
      "environment": "preview",
      "credentialsSource": "remote",
      "node": "24.21.0",
      "ios": {
        "buildConfiguration": "Release",
        "resourceClass": "medium",
        "simulator": false
      }
    }
  }
}
