{
  "name": "@fitquest-rebuild/mobile",
  "version": "0.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "NODE_OPTIONS=--dns-result-order=ipv4first expo start --localhost",
    "ios:debug": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:ios --no-bundler",
    "ios": "REACT_NATIVE_PACKAGER_HOSTNAME=127.0.0.1 expo run:ios --configuration Release --no-bundler",
    "test": "vitest run",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "expo": "57.0.24",
    "expo-crypto": "^57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-file-system": "~57.0.7",
    "expo-secure-store": "^57.0.4",
    "expo-sqlite": "~57.0.3",
    "react": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "5.7.0"
  },
  "devDependencies": {
    "@types/react": "19.2.7"
  }
}
